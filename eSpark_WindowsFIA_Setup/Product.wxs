				<File Id='System.Runtime.CompilerServices.Unsafe.dll' Name='System.Runtime.CompilerServices.Unsafe.dll' DiskId='1' Source='System.Runtime.CompilerServices.Unsafe.dll'/>
				<File Id='System.Numerics.Vectors.xml' Name='System.Numerics.Vectors.xml' DiskId='1' Source='System.Numerics.Vectors.xml'/>
