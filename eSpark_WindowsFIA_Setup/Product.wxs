				<File Id='NLog.dll' Name='NLog.dll' DiskId='1' Source='NLog.dll'/>
				<File Id='Microsoft.Extensions.Logging.Abstractions.xml' Name='Microsoft.Extensions.Logging.Abstractions.xml' DiskId='1' Source='Microsoft.Extensions.Logging.Abstractions.xml'/>
				<File Id='Microsoft.Extensions.Logging.Abstractions.dll' Name='Microsoft.Extensions.Logging.Abstractions.dll' DiskId='1' Source='Microsoft.Extensions.Logging.Abstractions.dll'/>
				<File Id='eSpark_FIA.sqlite' Name='eSpark_FIA.sqlite' DiskId='1' Source='eSpark_FIA.sqlite'/>
