				<File Id='EntityFramework.SqlServer.xml' Name='EntityFramework.SqlServer.xml' DiskId='1' Source='EntityFramework.SqlServer.xml'/>
				<File Id='EntityFramework.SqlServer.dll' Name='EntityFramework.SqlServer.dll' DiskId='1' Source='EntityFramework.SqlServer.dll'/>
				<File Id='Crc32C.NET.xml' Name='Crc32C.NET.xml' DiskId='1' Source='Crc32C.NET.xml'/>
				<File Id='Crc32C.NET.dll' Name='Crc32C.NET.dll' DiskId='1' Source='Crc32C.NET.dll'/>
