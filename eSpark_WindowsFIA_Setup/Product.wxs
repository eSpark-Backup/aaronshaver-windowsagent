      <Directory Id="ProgramMenuFolder" Name="Programs">
        <Directory Id="ProgramMenuDir" Name="WindowsFileAgent">
          <Component Id="ProgramMenuDir" Guid="82fb98a6-f47f-4476-baaa-799fd3c77780">
            <RemoveFolder Id='ProgramMenuDir' On='uninstall' />
            <RegistryValue Root='HKCU' Key='Software\[Manufacturer]\[ProductName]' Type='string' Value='' KeyPath='yes' />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <Feature Id='Complete' Level='1'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='HelperLibrary' />
      <ComponentRef Id='ProgramMenuDir' />
      <ComponentRef Id='x86directory' />
      <ComponentRef Id='x64directory' />
      <ComponentRef Id='Resourcesdirectory' />
	  <ComponentRef Id="RegistryEntries"/>
		
    </Feature>

    <Icon Id="logop256.ico" SourceFile="eSpark_WindowsFIA.exe" />

  </Product>
	<Fragment>
		<DirectoryRef Id="INSTALLDIR">
			<Component Id="RegistryEntries" Guid="82fb98a6-f47f-4476-baaa-799fd3c7975e">
				<RegistryKey Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Action="createAndRemoveOnUninstall">
					<RegistryValue Type="string" Name="eSpark_WindowsFIA.exe" Value="&quot;eSpark_WindowsFIA.exe&quot;" KeyPath="yes"/>
				</RegistryKey>
			</Component>
		</DirectoryRef>
	</Fragment>
</Wix>