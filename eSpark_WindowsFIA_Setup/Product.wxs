<?xml version='1.0' encoding='utf-8'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product Name='Windows File Management Agent' Id='82fb98a6-f47f-4476-baaa-799fd3c7975f' UpgradeCode='82fb98a6-f47f-4476-baaa-799fd3c7975f'
    Language='1033' Codepage='1252' Version='1.0.0' Manufacturer='eSpark Consulting Group'>

    <Package InstallPrivileges='elevated' Id='*' Keywords='Installer' Description="eSpark_WindowsFIA Installer"
      Comments='Windows File Management Agent is a registered trademark of eSpark Consulting Solutions.' Manufacturer='eSpark_consulting '
      InstallerVersion='100' Languages='1033' Compressed='yes' SummaryCodepage='1252' InstallScope="perMachine"/>

    <Media Id='1' Cabinet='Sample.cab' EmbedCab='yes' DiskPrompt="CD-ROM #1" />
    <Property Id='DiskPrompt' Value="eSpark_WindowsFIA Installation [1]" />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFilesFolder' Name='PFiles'>
        <Directory Id='eSpark' Name='eSpark'>
          <Directory Id='INSTALLDIR' Name='WindowsFileAgent'>

            <Directory Id='Resources' Name='Resources'>
              <Component Id='Resourcesdirectory' Guid='82fb98a6-f47f-4476-baaa-755fd3c7975f'>
                <File Id='logop256.ico' Name='logo-p256.ico' DiskId='1' Source='Resources\logo-p256.ico'/>
				<File Id='filter.png' Name='filter.png' DiskId='1' Source='Resources\filter.png'/>
				  <File Id='About.png' Name='About.png' DiskId='1' Source='Resources\About.png'/>
				  <File Id='FileSystemAgent.png' Name='FileSystemAgent.png' DiskId='1' Source='Resources\FileSystemAgent.png'/>
				  <File Id='Scheduler.png' Name='Scheduler.png' DiskId='1' Source='Resources\Scheduler.png'/>
				  <File Id='Settings.png' Name='Settings.png' DiskId='1' Source='Resources\Settings.png'/>				  
				  <File Id='Settings2.png' Name='Settings2.png' DiskId='1' Source='Resources\Settings2.png'/>
              </Component>
            </Directory>

            <Directory Id='x64dir' Name='x64'>
              <Component Id='x64directory' Guid='82fb98a6-f47f-4476-baaa-711fd3c7975f'>
                <File Id='x64SQLite.Interop.dll' Name='SQLite.Interop.dll' DiskId='1' Source='x64\SQLite.Interop.dll'/>
              </Component>
            </Directory>

            <Directory Id='x86dir' Name='x86'>
              <Component Id='x86directory' Guid='82fb98a6-f47f-4476-baaa-778fd3c7975f'>
				  <File Id='x86SQLite.Interop.dll' Name='SQLite.Interop.dll' DiskId='1' Source='x86\SQLite.Interop.dll'/>
              </Component>
            </Directory>


            <Component Id='MainExecutable' Guid='82fb98a6-f47f-4476-baaa-799fd3c7975f'>
            <File Id='eSpark_WindowsFIA.exe' Name='eSpark_WindowsFIA.exe' DiskId='1' Source='eSpark_WindowsFIA.exe' KeyPath='yes'>
				<Shortcut Advertise="yes"
							Id="desktopSc"
							Directory="DesktopFolder"
							Name="WindowsFMAgent"
							WorkingDirectory="INSTALLLOCATION"
							Description="Windows File Management Agent"
							Icon="logop256.ico">

				</Shortcut>
             </File>
                <File Id='eSpark_WindowsFIA.exe.config' Name='eSpark_WindowsFIA.exe.config' DiskId='1' Source='eSpark_WindowsFIA.exe.config'/>
				<File Id='app.manifest' Name='app.manifest' DiskId='1' Source='app.manifest'/>
				<File Id='MetroSetUI.dll' Name='MetroSet UI.dll' DiskId='1' Source='MetroSet UI.dll'/>
				<File Id='sqlite3.exe' Name='sqlite3.exe' DiskId='1' Source='sqlite3.exe'/>
				<File Id='eSpark_WindowsFIA.manifest' Name='eSpark_WindowsFIA.manifest' DiskId='1' Source='eSpark_WindowsFIA.manifest'/>
